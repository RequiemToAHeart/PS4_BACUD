<%- include('partials/header') %>
<div class="eyebrow">COURSE DISCOVERY</div>
<h1>Available courses</h1>
<p class="subtitle">Browse the current term's course offerings.</p>
<% if (result.error) { %>
  <div class="alert danger"><%= result.error %></div>
<% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Course</th><th>Section</th><th>Faculty</th><th>Units</th><th>Status</th></tr></thead>
    <tbody>
      <% result.data.courses.forEach(course => { %>
        <tr><td><strong><%= course.code %></strong><span class="cell-secondary"><%= course.title %></span></td><td><%= course.section %></td><td><%= course.faculty %></td><td><%= course.units %></td><td><span class="pill <%= course.open ? 'open' : 'closed' %>"><%= course.open ? 'Open' : 'Closed' %></span></td></tr>
      <% }) %>
    </tbody>
  </table></div>
  <p class="hint">Open status is published by the catalog node. Live seat availability is checked by the enrollment node.</p>
  <% if (user.role === 'student') { %><a class="primary inline-action" href="/enrollments">Go to enrollment</a><% } %>
<% } %>
<%- include('partials/footer') %>
